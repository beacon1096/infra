+test("queues prompts as follow-ups when an automatic Pi run wins the idle race", async () => {
+  const child = createPiChild();
+  const commands: Array<Record<string, unknown>> = [];
+  replyToCommands(child, (command) => {
+    commands.push(command);
+    if (command.type === "prompt" && command.streamingBehavior !== "followUp") {
+      throw new Error("Agent is already processing");
+    }
+    return {};
+  });
+  const session = await createRuntime(child).startSession({ cwd: "/workspace/project" });
+  await expect(session.prompt("next task")).resolves.toBeDefined();
+  expect(commands).toContainEqual(expect.objectContaining({
+    type: "prompt", message: "next task", streamingBehavior: "followUp",
+  }));
+  await session.close();
+});
+
+test("clears queued messages before aborting a Pi run", async () => {
+  const child = createPiChild();
+  const seen: string[] = [];
+  replyToCommands(child, (command) => {
+    seen.push(String(command.type));
+    return {};
+  });
+  const runtime = createRuntime(child);
+  const session = await runtime.startSession({ cwd: "/workspace/project" });
+
+  await session.abort();
+
+  expect(seen.filter((type) => type === "clear_queue" || type === "abort")).toEqual([
+    "clear_queue",
+    "abort",
+  ]);
+});
+
+test("aborts even when Pi does not implement clear_queue", async () => {
+  const child = createPiChild();
+  const seen: string[] = [];
+  replyToCommands(child, (command) => {
+    seen.push(String(command.type));
+    if (command.type === "clear_queue") {
+      throw new Error("unknown command: clear_queue");
+    }
+    return {};
+  });
+  const runtime = createRuntime(child);
+  const session = await runtime.startSession({ cwd: "/workspace/project" });
+
+  await expect(session.abort()).resolves.toBeUndefined();
+  expect(seen).toContain("abort");
+});
