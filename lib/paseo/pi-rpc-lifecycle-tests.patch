+test("waits for Pi settlement across queued follow-up agent loops", async () => {
+  const { pi, session, events } = await createSession();
+  const runtime = pi.latestSession();
+  const first = await session.startTurn("work");
+  runtime.emit({ type: "agent_start" });
+  runtime.emit({ type: "agent_end", messages: [] });
+  expect(events.turnCompletedEvents()).toHaveLength(0);
+  await expect(session.startTurn("too early")).rejects.toThrow("already active");
+  runtime.emit({ type: "agent_start" });
+  runtime.emit({ type: "agent_end", messages: [] });
+  expect(events.turnCompletedEvents()).toHaveLength(0);
+  runtime.emit({ type: "agent_settled" });
+  expect(events.turnCompletedEvents()).toEqual([
+    expect.objectContaining({ turnId: first.turnId }),
+  ]);
+  await expect(session.startTurn("next")).resolves.toBeDefined();
+});
+
+test("preserves terminal errors until Pi settlement", async () => {
+  const { pi, session, events } = await createSession();
+  await session.startTurn("work");
+  pi.latestSession().emit({
+    type: "agent_end",
+    messages: [{ role: "assistant", content: [], stopReason: "error", errorMessage: "provider failed" }],
+  });
+  expect(events.eventTypes()).not.toContain("turn_failed");
+  pi.latestSession().emit({ type: "agent_settled" });
+  await expect(events.nextTurnFailure()).resolves.toMatchObject({ error: "provider failed (stopReason=error)" });
+});
+
+test("assigns automatic background callback runs their own turn identity", async () => {
+  const { pi, session, events } = await createSession();
+  const first = await session.startTurn("work");
+  pi.latestSession().finishTurn();
+  pi.latestSession().emit({ type: "agent_start" });
+  pi.latestSession().emit({ type: "turn_start" });
+  await expect(session.startTurn("during callback")).rejects.toThrow("already active");
+  pi.latestSession().finishTurn();
+  const completed = events.turnCompletedEvents();
+  expect(completed).toHaveLength(2);
+  expect(completed[1].turnId).toBeTruthy();
+  expect(completed[1].turnId).not.toBe(first.turnId);
+});
+
+
+test("custom completion messages do not finish an active model turn", async () => {
+  const { pi, session, events } = await createSession();
+  const turn = await session.startTurn("work");
+  const runtime = pi.latestSession();
+  runtime.emit({ type: "agent_start" });
+  runtime.emit({ type: "message_end", message: { role: "custom", content: "background command done" } });
+  expect(events.turnCompletedEvents()).toHaveLength(0);
+  await expect(session.startTurn("too early")).rejects.toThrow("already active");
+  runtime.emit({ type: "agent_end", messages: [] });
+  expect(events.turnCompletedEvents()).toHaveLength(0);
+  runtime.emit({ type: "agent_settled" });
+  expect(events.turnCompletedEvents()).toEqual([expect.objectContaining({ turnId: turn.turnId })]);
+});
