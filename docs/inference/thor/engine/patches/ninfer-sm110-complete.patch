+
+std::size_t nvfp4_linear_add_sm110_workspace_capacity_bytes(std::int32_t tokens) {
+    WorkspaceLayoutBuilder layout;
+    (void)allocate(layout, tokens);
+    return layout.peak_bytes(1);
+}
+
+void nvfp4_linear_add_sm110_launch(const Tensor& x, const Weight& weight, Tensor& residual,
+                                   WorkspaceArena& workspace, cudaStream_t stream) {
+    auto scope = workspace.scope();
+    const Scratch scratch = allocate(workspace, x.ne[1]);
+    const auto tasks = ((static_cast<std::int64_t>(x.ne[1]) + 127) / 128 * 128) * (kInputRows / 16);
+    const int blocks = static_cast<int>(std::min<std::int64_t>((tasks + 255) / 256, 65535));
+    quantize<<<blocks, 256, 0, stream>>>(static_cast<const __nv_bfloat16*>(x.data), scratch.codes,
+        scratch.scales, x.ne[1], weight.input_scale_divisor);
+    CUDA_CHECK(cudaGetLastError());
+    Gemm gemm;
+    auto args = arguments(x.ne[1], scratch.codes, scratch.scales, &weight, residual.data);
+    require_success(gemm.can_implement(args), "can_implement");
+    require_success(gemm.initialize(args, scratch.gemm.data, stream), "initialize");
+    require_success(gemm.run(args, scratch.gemm.data, stream, nullptr, true), "run");
+    CUDA_CHECK(cudaGetLastError());
+}
