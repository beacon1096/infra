@@ -0,0 +1,43 @@
+#include "core/memory.h"
+
+#include <algorithm>
+#include <charconv>
+#include <limits>
+#include <sstream>
+#include <string>
+
+namespace ninfer {
+
+std::optional<std::size_t> parse_mem_available(std::istream& input) {
+    std::optional<std::size_t> available;
+    std::string line;
+    while (std::getline(input, line)) {
+        std::istringstream fields(line);
+        std::string key;
+        if (!(fields >> key) || key != "MemAvailable:") { continue; }
+        std::string value;
+        std::string unit;
+        std::string extra;
+        if (available || !(fields >> value >> unit) || unit != "kB" || fields >> extra) {
+            return std::nullopt;
+        }
+        std::size_t kib = 0;
+        const auto result = std::from_chars(value.data(), value.data() + value.size(), kib);
+        if (result.ec != std::errc{} || result.ptr != value.data() + value.size() ||
+            kib > std::numeric_limits<std::size_t>::max() / 1024) {
+            return std::nullopt;
+        }
+        available = kib * 1024;
+    }
+    if (input.bad() || !input.eof()) { return std::nullopt; }
+    return available;
+}
+
+std::size_t select_available_memory(bool integrated, std::size_t cuda_free,
+                                    std::size_t device_total,
+                                    std::optional<std::size_t> host_available) noexcept {
+    if (integrated && host_available) { return std::min(*host_available, device_total); }
+    return cuda_free;
+}
+
+} // namespace ninfer
