+    Mainloop, Epilogue, cutlass::gemm::PersistentScheduler>;
+using Gemm = cutlass::gemm::device::GemmUniversalAdapter<Kernel>;
+
+Gemm::Arguments arguments(std::int32_t tokens, const void* a = nullptr,
+                          const void* sa = nullptr, const Weight* weight = nullptr,
+                          void* residual = nullptr) {
+    Gemm::Arguments args{};
+    args.mode = cutlass::gemm::GemmUniversalMode::kGemm;
+    args.problem_shape = cute::make_shape(tokens, kOutputRows, kInputRows, 1);
+    args.mainloop.ptr_A = static_cast<const Element*>(a);
+    args.mainloop.ptr_SFA = static_cast<const Scale*>(sa);
+    args.mainloop.ptr_B = weight ? static_cast<const Element*>(weight->qdata) : nullptr;
+    args.mainloop.ptr_SFB = weight ? static_cast<const Scale*>(weight->scales) : nullptr;
+    args.mainloop.dA = cute::make_int_tuple_from<Kernel::StrideA>(kInputRows, 0);
+    args.mainloop.dB = cute::make_int_tuple_from<Kernel::StrideB>(kInputRows, 0);
+    args.mainloop.layout_SFA = Mainloop::Sm1xxBlkScaledConfig::tile_atom_to_shape_SFA(args.problem_shape);
+    args.mainloop.layout_SFB = Mainloop::Sm1xxBlkScaledConfig::tile_atom_to_shape_SFB(args.problem_shape);
+    args.epilogue.ptr_C = static_cast<const Output*>(residual);
+    args.epilogue.ptr_D = static_cast<Output*>(residual);
+    args.epilogue.dC = cute::make_int_tuple_from<Kernel::StrideC>(kOutputRows, 0);
+    args.epilogue.dD = args.epilogue.dC;
+    args.epilogue.thread.alpha = weight ? 1.0F / (weight->input_scale_divisor * weight->weight_scale_divisor) : 1.0F;
+    args.epilogue.thread.beta = 1.0F;
+    args.scheduler.max_swizzle_size = 1;
+    args.scheduler.raster_order = decltype(args.scheduler.raster_order)::Heuristic;
+    args.hw_info.cluster_shape = dim3(1, 1, 1);
+    args.hw_info.cluster_shape_fallback = dim3(1, 1, 1);
+    return args;
+}
+
+struct Scratch {
+    std::uint8_t* codes;
+    std::uint8_t* scales;
+    DeviceSpan gemm;
+};
+
+template<class Arena>
+Scratch allocate(Arena& arena, std::int32_t tokens) {
+    const std::size_t code_bytes = nvfp4_w4a4_checked_bytes(tokens, kInputRows / 2);
+    const std::size_t padded_tokens = (static_cast<std::size_t>(tokens) + 127) / 128 * 128;
+    const std::size_t scale_bytes = padded_tokens * (kInputRows / 16);
+    auto codes = arena.alloc_bytes(code_bytes, 256);
+    auto scales = arena.alloc_bytes(scale_bytes, 256);
+    const std::size_t gemm_bytes = Gemm::get_workspace_size(arguments(tokens));
+    DeviceSpan gemm{};
+    if (gemm_bytes != 0) { gemm = arena.alloc_bytes(gemm_bytes, 256); }
+    return {static_cast<std::uint8_t*>(codes.data), static_cast<std::uint8_t*>(scales.data), gemm};
+}
+
+__global__ void quantize(const __nv_bfloat16* input, std::uint8_t* codes,
+                          std::uint8_t* scales, std::int32_t tokens, float divisor) {
+    constexpr int kGroups = kInputRows / 16;
+    const std::int64_t padded_tokens = (static_cast<std::int64_t>(tokens) + 127) / 128 * 128;
+    for (std::int64_t task = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+         task < padded_tokens * kGroups; task += static_cast<std::int64_t>(gridDim.x) * blockDim.x) {
+        const std::int64_t token = task / kGroups;
+        const int group = static_cast<int>(task % kGroups);
+        const std::int64_t scale_index = (token / 128 * (kInputRows / 64) + group / 4) * 512 +
+            token % 32 * 16 + token % 128 / 32 * 4 + group % 4;
+        if (token >= tokens) {
+            scales[scale_index] = 0;
+            continue;
+        }
+        const Nvfp4QuantizedK16 value = quantize_nvfp4_k16(input + token * kInputRows + group * 16, divisor);
+        store_vec(codes + token * (kInputRows / 2) + group * 8, make_uint2(value.codes_lo, value.codes_hi));
+        scales[scale_index] = value.scale;
+    }
+}
+
+void require_success(cutlass::Status status, const char* action) {
+    if (status != cutlass::Status::kSuccess) {
+        throw std::runtime_error(std::string("nvfp4 SM110 linear_add ") + action + ": " + cutlassGetStatusString(status));
+    }
+}
+
