+    if (props.integrated) {
+        // CUDA free memory excludes reclaimable Linux page cache on integrated GPUs.
+        std::ifstream meminfo("/proc/meminfo");
+        return select_available_memory(true, free_bytes, std::min(total_bytes, total_vram()),
+                                       parse_mem_available(meminfo));
+    }
+#endif
+    return free_bytes;
+}
 
