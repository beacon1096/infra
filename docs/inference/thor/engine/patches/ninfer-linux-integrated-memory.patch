+++ b/tests/test_memory.cpp
@@ -0,0 +1,66 @@
+#include "core/memory.h"
+
+#include <iostream>
+#include <limits>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+
+namespace {
+
+void require(bool value, const char* message) {
+    if (!value) { throw std::runtime_error(message); }
+}
+
+std::optional<std::size_t> parse(const std::string& text) {
+    std::istringstream input(text);
+    return ninfer::parse_mem_available(input);
+}
+
+} // namespace
+
+int main() {
+    try {
+        using ninfer::select_available_memory;
+        require(parse("MemTotal: 128000000 kB\nMemFree: 100 kB\n"
+                      "MemAvailable:   59402308 kB\nCached: 123 kB\n") ==
+                    std::size_t{59402308} * 1024,
+                "Linux available memory was not parsed in KiB");
+        require(parse("MemAvailable:\t0 kB") == 0, "zero available memory was discarded");
+        for (const std::string text : {
+                 "MemFree: 100 kB\n", "MemAvailable: -1 kB\n",
+                 "MemAvailable: +1 kB\n", "MemAvailable: 1 MB\n",
+                 "MemAvailable: 1x kB\n", "MemAvailable: 1\n",
+                 "MemAvailable: 1 kB extra\n",
+                 "MemAvailable: 1 kB\nMemAvailable: 2 kB\n"}) {
+            require(!parse(text), "malformed or missing available memory was accepted");
+        }
+        require(!parse("MemAvailable: " +
+                       std::to_string(std::numeric_limits<std::size_t>::max()) + " kB"),
+                "KiB multiplication overflow was accepted");
+        require(!parse("MemAvailable: 99999999999999999999999999 kB"),
+                "integer parsing overflow was accepted");
+        std::istringstream unreadable("MemAvailable: 123 kB");
+        unreadable.setstate(std::ios::badbit);
+        require(!ninfer::parse_mem_available(unreadable), "read failure was accepted");
+        std::istringstream unopened;
+        unopened.setstate(std::ios::failbit);
+        require(!ninfer::parse_mem_available(unopened), "open failure was accepted");
+        require(select_available_memory(true, 11, 128, 56) == 56,
+                "integrated GPU did not include reclaimable memory");
+        require(select_available_memory(true, 11, 128, 4) == 4,
+                "host memory pressure was ignored");
+        require(select_available_memory(true, 11, 128, 200) == 128,
+                "host estimate exceeded device capacity");
+        require(select_available_memory(true, 11, 128, 0) == 0,
+                "zero host availability incorrectly fell back to CUDA");
+        require(select_available_memory(true, 11, 128, std::nullopt) == 11,
+                "missing host estimate did not fall back to CUDA");
+        require(select_available_memory(false, 11, 128, 56) == 11,
+                "discrete GPU incorrectly used host memory");
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+    return 0;
+}
