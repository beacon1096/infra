    {
      "id": "strata-chinese-three-point-summary",
      "category": "chinese-summary",
      "mode": "quality",
      "provenance": {"kind": "new-synthetic", "source": "docs/inference/strata/benchmark/fixtures.json#strata-chinese-three-point-summary"},
      "request": {
        "messages": [{"role": "user", "content": "根据材料写恰好三条中文摘要，每条一句，覆盖关键事实与证据限制，不增加材料之外的结论。\n材料：社区试点将图书馆开放时间从工作日 9:00–17:00 延长到 8:00–20:00，试点持续四周。四周内晚间到馆人数比试点前四周增加 30%。同期没有记录周末人数，也没有对照社区，因此材料不能证明延长开放时间单独造成了增长。"}],
        "max_tokens": 512,
        "temperature": 0,
        "chat_template_kwargs": {"enable_thinking": false}
      },
      "check": {
        "kind": "manual",
        "criteria": [
          "人工评审；不是自动语义判分或既有历史结果。",
          "恰好三条中文摘要，每条一句，表达简洁且忠于材料。",
          "准确保留开放时间变化、四周试点及晚间到馆人数增加 30% 这三项信息。",
          "明确材料不能单独证明因果，不补写周末数据或对照社区结果。"
        ]
      }
    },
