+func TestWebhookHandler_DistinctDeliveriesWithSameIssueTitleCreateDistinctIssues(t *testing.T) {
+	agentID := createWebhookTestAgent(t, "Webhook issue dedupe Agent")
+	apID := createWebhookTestAutopilot(t, agentID, "active", "create_issue")
+	trig := createWebhookTriggerViaHandler(t, apID)
+
+	deliveryIDs := make([]string, 0, 2)
+	for _, key := range []string{"forgejo-pr-101", "forgejo-pr-102"} {
+		w := postWebhook(t, *trig.WebhookToken, map[string]any{"pull_request": key}, map[string]string{
+			"Idempotency-Key": key,
+		})
+		deliveryIDs = append(deliveryIDs, requireAcceptedWebhookResponse(t, w))
+	}
+
+	issueIDs := make(map[string]struct{}, 2)
+	for _, deliveryID := range deliveryIDs {
+		delivery := processQueuedWebhookDelivery(t, deliveryID)
+		if delivery.Status != deliveryStatusDispatched {
+			t.Fatalf("delivery %s status = %q, want dispatched", deliveryID, delivery.Status)
+		}
+		run, err := testHandler.Queries.GetAutopilotRun(context.Background(), delivery.AutopilotRunID)
+		if err != nil {
+			t.Fatalf("load run for delivery %s: %v", deliveryID, err)
+		}
+		if run.Status != "issue_created" || !run.IssueID.Valid {
+			t.Fatalf("run for delivery %s = status %q issue_id %v, want issue_created with issue", deliveryID, run.Status, run.IssueID.Valid)
+		}
+		issueIDs[uuidToString(run.IssueID)] = struct{}{}
+	}
+	if len(issueIDs) != 2 {
+		t.Fatalf("distinct webhook deliveries created %d distinct issues, want 2", len(issueIDs))
+	}
+}
