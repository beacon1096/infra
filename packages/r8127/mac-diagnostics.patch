 static void
+rtl8127_mac_diag(struct net_device *dev, const char *stage)
+{
+        struct rtl8127_private *tp = netdev_priv(dev);
+        u8 mac[MAC_ADDR_LEN];
+        u8 backup[MAC_ADDR_LEN];
+        u32 low;
+        u16 high;
+        int i;
+
+        if (dev->reg_state != NETREG_UNINITIALIZED)
+                return;
+
+        low = RTL_R32(tp, BACKUP_ADDR0_8125);
+        high = RTL_R16(tp, BACKUP_ADDR1_8125);
+        for (i = 0; i < MAC_ADDR_LEN; i++)
+                mac[i] = RTL_R8(tp, MAC0 + i);
+        for (i = 0; i < 4; i++)
+                backup[i] = low >> (i * 8);
+        backup[4] = high;
+        backup[5] = high >> 8;
+
+        dev_info(&tp->pci_dev->dev,
+                 "r8127-mac-diag: stage=%s mac0=%pM backup=%pM rxconfig=%08x chipcmd=%02x d2=%02x mcfg=%u eeprom_type=%u random_mac=%u\n",
+                 stage, mac, backup, (u32)RTL_R32(tp, RxConfig),
+                 RTL_R8(tp, ChipCmd), RTL_R8(tp, 0xD2),
+                 tp->mcfg, tp->eeprom_type, tp->random_mac);
+}
+
+static void
 rtl8127_nic_reset(struct net_device *dev)
 {
         struct rtl8127_private *tp = netdev_priv(dev);
         int i;
 
+        rtl8127_mac_diag(dev, "nic-reset-entry");
         rtl8127_disable_rx_packet_filter(tp);
 
         rtl8127_enable_rxdvgate(dev);
@@ -4270,6 +4300,7 @@
         rtl8127_clear_stop_all_request(dev);
 
         /* Soft reset the chip. */
+        rtl8127_mac_diag(dev, "before-cmd-reset");
         RTL_W8(tp, ChipCmd, CmdReset);
 
         /* Check that the chip has finished the reset. */
@@ -4279,8 +4310,15 @@
                         break;
         }
 
+        rtl8127_mac_diag(dev, "after-cmd-reset");
+        if (dev->reg_state == NETREG_UNINITIALIZED)
+                dev_info(&tp->pci_dev->dev,
+                         "r8127-mac-diag: reset_poll_remaining=%d timeout=%u\n",
+                         i, i == 0);
+
         /* reset rcr */
         RTL_W32(tp, RxConfig, (RX_DMA_BURST_512 << RxCfgDMAShift));
+        rtl8127_mac_diag(dev, "after-rxconfig-reset");
 }
 
