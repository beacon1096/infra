@@ -0,0 +1,127 @@
+package provider
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+
+	"github.com/hashicorp/terraform-plugin-framework/attr"
+	"github.com/hashicorp/terraform-plugin-framework/types"
+)
+
+func TestUserCredentialsPayloadOwnership(t *testing.T) {
+	t.Parallel()
+
+	var descriptor resourceDescriptor
+	for _, candidate := range generatedResources {
+		if candidate.Name == "user" {
+			descriptor = candidate
+			break
+		}
+	}
+	if descriptor.Name == "" {
+		t.Fatal("user resource descriptor not found")
+	}
+	r := &genericResource{descriptor: descriptor}
+
+	credentialType := types.ObjectType{AttrTypes: map[string]attr.Type{
+		"type":          types.StringType,
+		"secret":        types.StringType,
+		"credential_id": types.StringType,
+	}}
+	credential := func(secret string) types.List {
+		entry := types.ObjectValueMust(credentialType.AttrTypes, map[string]attr.Value{
+			"type":          types.StringValue("Password"),
+			"secret":        types.StringValue(secret),
+			"credential_id": types.StringValue("existing-id"),
+		})
+		return types.ListValueMust(credentialType, []attr.Value{entry})
+	}
+	nullCredentials := types.ListNull(credentialType)
+	emptyCredentials := types.ListValueMust(credentialType, []attr.Value{})
+	maskedCredentials := credential("****")
+	explicitCredentials := credential("sandbox-explicit-password")
+
+	object := func(credentials attr.Value) types.Object {
+		attrTypes := map[string]attr.Type{
+			"id":          types.StringType,
+			"name":        types.StringType,
+			"domain_id":   types.StringType,
+			"description": types.StringType,
+		}
+		values := map[string]attr.Value{
+			"id":          types.StringValue("sandbox-user"),
+			"name":        types.StringValue("sandbox"),
+			"domain_id":   types.StringValue("sandbox-domain"),
+			"description": types.StringValue("updated description"),
+		}
+		if credentials != nil {
+			attrTypes["credentials"] = types.ListType{ElemType: credentialType}
+			values["credentials"] = credentials
+		}
+		return types.ObjectValueMust(attrTypes, values)
+	}
+
+	cases := []struct {
+		name       string
+		config     attr.Value
+		plan       attr.Value
+		wantSent   bool
+		wantSecret string
+	}{
+		{name: "missing configuration with imported mask", plan: maskedCredentials},
+		{name: "omitted configuration with imported mask", config: nullCredentials, plan: maskedCredentials},
+		{name: "omitted configuration with historical secret", config: nullCredentials, plan: explicitCredentials},
+		{name: "omitted configuration with null plan", config: nullCredentials, plan: nullCredentials},
+		{name: "omitted configuration with empty plan", config: nullCredentials, plan: emptyCredentials},
+		{name: "explicit credentials", config: explicitCredentials, plan: explicitCredentials, wantSent: true, wantSecret: "sandbox-explicit-password"},
+		{name: "explicit empty credentials", config: emptyCredentials, plan: emptyCredentials, wantSent: true},
+		{name: "explicit credentials with ignored plan value", config: explicitCredentials, plan: maskedCredentials, wantSent: true, wantSecret: "****"},
+		{name: "unknown explicit configuration retains existing behavior", config: types.ListUnknown(credentialType), plan: maskedCredentials, wantSent: true, wantSecret: "****"},
+	}
+	for _, test := range cases {
+		for _, update := range []bool{false, true} {
+			operation := "create"
+			if update {
+				operation = "update"
+			}
+			t.Run(test.name+"/"+operation, func(t *testing.T) {
+				var payload map[string]any
+				var err error
+				if update {
+					payload, err = r.updatePayload(context.Background(), object(test.plan), object(test.config))
+				} else {
+					payload, err = r.payload(context.Background(), object(test.plan), object(test.config), false)
+				}
+				if err != nil {
+					t.Fatal(err)
+				}
+				wire, err := json.Marshal(payload)
+				if err != nil {
+					t.Fatal(err)
+				}
+				var decoded map[string]any
+				if err := json.Unmarshal(wire, &decoded); err != nil {
+					t.Fatal(err)
+				}
+				credentials, present := decoded["credentials"]
+				if present != test.wantSent {
+					t.Fatalf("credentials present = %t, want %t; payload: %s", present, test.wantSent, wire)
+				}
+				if decoded["description"] != "updated description" || decoded["@type"] != "User" {
+					t.Fatalf("intended account attributes lost: %s", wire)
+				}
+				if test.wantSent {
+					entries := credentials.(map[string]any)
+					if test.wantSecret == "" {
+						if len(entries) != 0 {
+							t.Fatalf("explicit credential removal changed: %s", wire)
+						}
+					} else if entry := entries["0"].(map[string]any); entry["secret"] != test.wantSecret {
+						t.Fatalf("explicit credential behavior changed: %s", wire)
+					}
+				}
+			})
+		}
+	}
+}
