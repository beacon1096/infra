machine:
  network:
    disableSearchDomain: true
    nameservers:
      #% for item in node_dns_servers %#
      - #{ item }#
      #% endfor %#
    extraHostEntries:
      # Keep forgejo.beaco.works resolving to the envoy-internal LB IP from the
      # nodes: node-level image pulls and host traffic stay on the LAN instead
      # of egressing to the public Caddy edge (spec 009-caddy-edge-ingress).
      # This is deliberate split-horizon locality, not a Cloudflare workaround;
      # public clients resolve the name to the edge via DNS.
      - ip: #{ cluster_gateway_addr }#
        aliases:
          - forgejo.beaco.works
