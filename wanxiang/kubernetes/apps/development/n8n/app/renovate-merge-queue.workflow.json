        "id": "ea52b290-a3e6-45e7-807b-294f70f159f7",
        "name": "Claim Renovate Queue Item",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          224,
          0
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "CREATE TABLE IF NOT EXISTS renovate_merge_queue (\n  repo text NOT NULL,\n  pr_number bigint NOT NULL,\n  approved_head_sha char(40) NOT NULL,\n  approved_base_sha char(40) NOT NULL,\n  delta_digest char(64) NOT NULL,\n  delta_count integer NOT NULL,\n  approval_jti uuid NOT NULL UNIQUE,\n  multica_summary text NOT NULL,\n  evidence_url text NOT NULL DEFAULT '',\n  state text NOT NULL CHECK (state IN ('queued', 'updating', 'waiting_ci', 'merging', 'merged', 'blocked', 'expired')),\n  attempt_count integer NOT NULL DEFAULT 0,\n  lease_until timestamptz,\n  approved_at timestamptz NOT NULL DEFAULT now(),\n  updated_at timestamptz NOT NULL DEFAULT now(),\n  expires_at timestamptz NOT NULL,\n  last_error text NOT NULL DEFAULT '',\n  multica_closed_at timestamptz,\n  PRIMARY KEY (repo, pr_number)\n);\nALTER TABLE renovate_merge_queue ADD COLUMN IF NOT EXISTS multica_closed_at timestamptz;\nWITH expired AS (\n  UPDATE renovate_merge_queue SET state = 'expired', updated_at = now(), last_error = 'approval expired'\n  WHERE state IN ('queued', 'updating', 'waiting_ci', 'merging') AND expires_at <= now()\n), candidate AS (\n  SELECT repo, pr_number FROM renovate_merge_queue\n  WHERE ((state IN ('queued', 'updating', 'waiting_ci', 'merging') AND expires_at > now())\n      OR (state = 'merged' AND multica_closed_at IS NULL))\n    AND (lease_until IS NULL OR lease_until < now())\n  ORDER BY CASE WHEN state = 'merged' THEN 1 ELSE 0 END, approved_at, repo, pr_number\n  FOR UPDATE SKIP LOCKED LIMIT 1\n)\nUPDATE renovate_merge_queue q SET lease_until = now() + interval '45 seconds', attempt_count = attempt_count + 1, updated_at = now()\nFROM candidate c WHERE q.repo = c.repo AND q.pr_number = c.pr_number\nRETURNING q.*;",
          "options": {}
        },
        "credentials": {
          "postgres": {
            "id": "reviewCapabilityPg",
            "name": "Review Capability PostgreSQL"
          }
        }
      },
