      {
        "id": "ec95a52d-6305-4584-8355-695f1a73ad73",
        "name": "Verify Queued Tree Delta",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          2240,
          64
        ],
        "parameters": {
          "jsCode": "const crypto = require('crypto');\nconst item = $('Decide Queue Action').first().json;\nconst baseResponse = $('Get Current Queue Base Tree').first().json;\nconst headResponse = $('Get Current Queue Head Tree').first().json;\nconst base = baseResponse.body ?? {};\nconst head = headResponse.body ?? {};\nconst valid = (response, tree) => response.statusCode === 200 && tree.truncated !== true && Array.isArray(tree.tree) && tree.tree.length <= 5000;\nif (!valid(baseResponse, base) || !valid(headResponse, head)) return { json: { ...item, DELTA_MATCHES: false, ERROR_MESSAGE: 'current Forgejo tree was missing, invalid, or truncated' } };\nconst leaves = (tree) => new Map(tree.tree.filter((entry) => entry?.type !== 'tree' && typeof entry?.path === 'string').map((entry) => [entry.path, { mode: String(entry.mode ?? ''), type: String(entry.type ?? ''), sha: String(entry.sha ?? '') }]));\nconst baseLeaves = leaves(base);\nconst headLeaves = leaves(head);\nconst paths = [...new Set([...baseLeaves.keys(), ...headLeaves.keys()])].sort();\nconst delta = paths.map((path) => ({ path, base: baseLeaves.get(path) ?? null, head: headLeaves.get(path) ?? null })).filter((entry) => JSON.stringify(entry.base) !== JSON.stringify(entry.head));\nconst digest = crypto.createHash('sha256').update(JSON.stringify(delta)).digest('hex');\nreturn { json: { ...item, CURRENT_DELTA_DIGEST: digest, CURRENT_DELTA_COUNT: delta.length, DELTA_MATCHES: digest === item.delta_digest && delta.length === Number(item.delta_count), ERROR_MESSAGE: digest === item.delta_digest ? '' : 'tree delta changed after base update' } };"
        }
      },
