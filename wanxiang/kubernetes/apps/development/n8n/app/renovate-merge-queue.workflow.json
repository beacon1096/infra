      {
        "id": "2baf1670-7064-4b9f-92f5-6494601b9b07",
        "name": "Decide Queue Action",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          896,
          0
        ],
        "parameters": {
          "jsCode": "const item = $('Claim Renovate Queue Item').first().json;\nconst response = $json;\nconst pr = response.body ?? {};\nconst currentHead = String(pr.head?.sha ?? '').toLowerCase();\nconst currentBase = String(pr.base?.sha ?? '').toLowerCase();\nconst mergeBase = String(pr.merge_base ?? '').toLowerCase();\nlet action = 'block';\nlet error = '';\nif (response.statusCode !== 200) error = 'failed to read queued PR';\nelse if (pr.merged === true) action = 'merged';\nelse if (pr.state !== 'open') error = 'queued PR is closed without merge';\nelse if (String(pr.user?.login ?? pr.user?.username ?? '') !== 'renovate') error = 'queued PR author is not renovate';\nelse if (pr.base?.ref !== 'main') error = 'queued PR base is not main';\nelse if (!/^[0-9a-f]{40}$/.test(currentHead) || !/^[0-9a-f]{40}$/.test(currentBase) || !/^[0-9a-f]{40}$/.test(mergeBase)) error = 'queued PR returned invalid commit ids';\nelse if (mergeBase !== currentBase) action = 'update';\nelse action = 'snapshot';\nreturn { json: { ...item, ACTION: action, CURRENT_HEAD_SHA: currentHead, CURRENT_BASE_SHA: currentBase, MERGE_BASE_SHA: mergeBase, ERROR_MESSAGE: error } };"
        }
      },
