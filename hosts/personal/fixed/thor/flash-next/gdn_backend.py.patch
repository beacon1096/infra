+# Optional diagnostics: dump the per-layer SSM state written by the extend
+# (prefill) kernel into SGLANG_GDN_STATE_DUMP/<layer>_seq<len>.npy, so state
+# dtype drift can be compared directly instead of only through logits. No-op
+# unless SGLANG_GDN_STATE_DUMP is set; layers filter via
+# SGLANG_GDN_STATE_DUMP_LAYERS (comma list, or "all"/unset for every layer).
+_gdn_state_dump_dir = os.environ.get("SGLANG_GDN_STATE_DUMP")
+_gdn_state_dump_layers = os.environ.get("SGLANG_GDN_STATE_DUMP_LAYERS", "all")
+
+
+def _gdn_state_dump_selected(layer_id: int) -> bool:
+    if not _gdn_state_dump_dir:
+        return False
+    raw = _gdn_state_dump_layers.strip()
+    if raw.lower() in ("", "all"):
+        return True
+    return str(layer_id) in {item.strip() for item in raw.split(",")}
+
 
